\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces \textbf  {Attack Surface Map.} Entry points and attack paths of the three application-layer attacker profiles across the enterprise RAG pipeline. Blue solid arrows (P1) pass through the Input Filter as legitimate queries. Red dashed arrows (P2) bypass the filter through injection or jailbreaking. Purple dotted arrows (P3) propagate upward from the Admin Upload Port through corpus poisoning. Profile 4 is omitted to preserve readability; see Section~\ref {sec:limitations}.}}{32}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:attack-surface}{{4.1}{32}{\textbf {Attack Surface Map.} Entry points and attack paths of the three application-layer attacker profiles across the enterprise RAG pipeline. Blue solid arrows (P1) pass through the Input Filter as legitimate queries. Red dashed arrows (P2) bypass the filter through injection or jailbreaking. Purple dotted arrows (P3) propagate upward from the Admin Upload Port through corpus poisoning. Profile 4 is omitted to preserve readability; see Section~\ref {sec:limitations}}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Diagram 2: RAG System --- Trust Boundary Map}{33}{section.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces \textbf  {Trust Boundary Map.} Security zones and data flows of the enterprise RAG system. Six numbered green arrows trace normal pipeline flows; three red dashed arrows mark adversarial flows that cross the trust boundary: (A)~injection bypass, (B)~corpus poisoning, (C)~indirect injection from external web content.}}{34}{figure.caption.3}\protected@file@percent }
\newlabel{fig:trust-boundary}{{4.2}{34}{\textbf {Trust Boundary Map.} Security zones and data flows of the enterprise RAG system. Six numbered green arrows trace normal pipeline flows; three red dashed arrows mark adversarial flows that cross the trust boundary: (A)~injection bypass, (B)~corpus poisoning, (C)~indirect injection from external web content}{figure.caption.3}{}}
