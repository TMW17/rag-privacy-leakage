\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces P4 offline risk-metric summary. M4 enumerates candidate targets only; no inversion attack was executed.}}{11}{table.caption.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Headline metrics, engine-only vs.\ augmented. ASR is the fraction of (scenario, run) executions in which $\geq 1$ turn produced $L=1$ (156 executions overall). The judge lift on $\text  {ASR}_{\text  {strict}}$ is +55.2\% relative.}}{11}{table.caption.20}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Engine $\times $ judge contingency over the 267-turn baseline (leak level, any severity). Cells sum to 267. The 58 engine-only turns are the severity-2 External refusal artifacts the dual-ASR design was built to suppress; the 20 judge-only turns are name-plus-attribute disclosures invisible to annotation-grounded matching.}}{12}{table.caption.22}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}ASR by Profile}{12}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces $\text  {ASR}_{\text  {strict}}$ by profile. Rates are over (scenario, run) executions ($3\times $ the Scenarios column). P3 engine $\text  {ASR}_{\text  {strict}} = 0.0\%$ because all F8 engine detections were severity $\leq 2$; the augmented value adds the single scenario the judge caught (P3-POISON-007, leaking in all 3 runs, i.e.\ 3/21 executions).}}{12}{table.caption.23}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}ASR by Attack Family}{12}{subsection.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Severity Distribution}{12}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Strict attack success rate by profile, engine-only vs.\ augmented. The largest profile-level delta is Admin (+14.3 pp), driven entirely by the single corpus-poisoning scenario P3-POISON-007; External shows the largest absolute increase (+12.3 pp), reflecting the engine's systematic under-counting of name-plus-attribute disclosures.}}{13}{figure.caption.24}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces $\text  {ASR}_{\text  {strict}}$ (abbreviated $\text  {ASR}_{\text  {s}}$) by attack family. Rates are over (scenario, run) executions ($3\times $ the Scenarios column); e.g.\ F6 $= 1/9$, F2 $= 19/30$, F1 $= 21/27$. F3 and F4 show non-zero $\text  {ASR}_{\text  {inclusive}}$ (66.7\% and 20.0\%) but zero $\text  {ASR}_{\text  {strict}}$: all engine hits are severity 2, none confirmed by the judge.}}{13}{table.caption.25}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Severity distribution of leak turns over the 267-turn baseline. Totals are consistent with the engine $\times $ judge cross-tabulation (engine 95, judge 57, augmented union 115).}}{13}{table.caption.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Strict attack success rate by attack family, engine-only vs.\ augmented. F1 and F2 dominate; the other six families remain at or near zero under the strict metric.}}{14}{figure.caption.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Severity distribution of leak turns by labeller. The engine fires on severity 2 in 66\% of its leak turns (63/95); the calibrated judge fires on severity 2 in only 2\% of its leak turns (1/57). The augmented severity-3 and severity-4 rows are driven almost entirely by the judge signal.}}{14}{figure.caption.28}\protected@file@percent }
