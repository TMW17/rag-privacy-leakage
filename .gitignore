# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Distribution / packaging
*.egg-info/
dist/
build/

# Environments
.env
.venv/
.venv-presidio/
venv/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/

# OS
.DS_Store

# Phase 2 generated artifacts (keep directories, ignore contents)
data/rag_index/chromadb/*
!data/rag_index/chromadb/.gitkeep
data/rag_index/poisoned_chromadb/*
!data/rag_index/poisoned_chromadb/.gitkeep
data/rag_index/sanitized_chromadb/*
!data/rag_index/sanitized_chromadb/.gitkeep
experiment_logs/*.jsonl
results/baseline/*.csv
results/judge_validation/*.csv
results/p4_offline/*.csv

# External datasets (large, local-only — never commit)
data/external/

# Chatbot runtime audit logs (the curated smoke evidence is committed at app/smoke/smoke_results.json;
# these are regenerated on every server/smoke run and would drift)
results/phase3/audit/smoke.jsonl
results/phase3/audit/chatbot.jsonl

# LaTeX build byproducts in report dirs (the .tex + .pdf are committed; these regenerate on each compile)
# These extensions are LaTeX-only and unambiguous — ignore them anywhere.
*.aux
*.toc
*.fls
*.fdb_latexmk
*.xdv
*.bbl
*.blg
*.lof
*.lot
*.synctex.gz
texput.log

# .log and .out are AMBIGUOUS — experiment runs write real evidence to
# results/phase3/**/execute.log, dryrun.log, etc. and those ARE committed.
# So ignore these two only inside directories that hold a .tex.
reports/**/*.log
reports/**/*.out
results/**/report/*.log
results/**/report/*.out
results/**/report/thesis/*.log
results/**/report/thesis/*.out
